# ============================================================
#  Environment variables – copy this file to .env and fill in
#  your own values. Never commit .env to version control.
# ============================================================

# ── n8n basic auth ──────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=PLACEHOLDER_N8N_PASSWORD

# ── n8n encryption key (generate with: openssl rand -hex 16) ─
N8N_ENCRYPTION_KEY=PLACEHOLDER_ENCRYPTION_KEY_32CHARS

# ── n8n public URL (set to your server's domain in production)
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# ── Google OAuth 2.0 (for Google Drive integration) ─────────
#    Create credentials at https://console.cloud.google.com/
#    Authorised redirect URI: http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_CLIENT_ID=PLACEHOLDER_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=PLACEHOLDER_GOOGLE_CLIENT_SECRET

# ── Mock API key (shared secret between n8n and mock-api) ───
MOCK_API_KEY=PLACEHOLDER_MOCK_API_KEY

# ── Timezone ─────────────────────────────────────────────────
TIMEZONE=Europe/Lisbon

GEMINI_API_KEY=your_api_key_here
INCOMING_FOLDER_ID=your_folder_id_here
PROCESSED_FOLDER_ID=your_folder_id_here
FAILED_FOLDER_ID=your_folder_id_here
