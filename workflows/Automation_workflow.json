    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// MUST be: Run Once for Each Item\n\nconst fileName = $input.item.json.name || 'unknown';\nconst fileId   = $input.item.json.id   || '';\n\nconst nameLower = fileName.toLowerCase();\n\n// Check file type\nconst isPdf = nameLower.endsWith('.pdf');\n\n// ❌ Do NOT throw error → return object\nif (!isPdf) {\n  return {\n    json: {\n      fileName,\n      fileId,\n      _skip: true,\n      _reason: `Unsupported file type: ${fileName}`\n    }\n  };\n}\n\n// Get binary safely\nconst binary = $input.item.binary || {};\nconst binaryKeys = Object.keys(binary);\n\nif (binaryKeys.length === 0) {\n  return {\n    json: {\n      fileName,\n      fileId,\n      _skip: true,\n      _reason: `No binary data`\n    }\n  };\n}\n\nconst key = binaryKeys[0];\n\n// ✅ Return SINGLE object (not array)\nreturn {\n  json: {\n    fileName,\n    fileId,\n    _skip: false\n  },\n  binary: {\n    data: binary[key]\n  }\n};"
      },
      "id": "2ed37f26-0fd2-4b99-8805-bb5eaedcc81d",
