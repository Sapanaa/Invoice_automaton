    {
      "parameters": {
        "jsCode": "// Combine PDF text output with fileName and fileId\nconst pdfText = $input.first().json.text || '';\nconst prev = $('Read File').first().json;\nreturn [{ json: { text: pdfText, fileName: prev.fileName, fileId: prev.fileId } }];"
      },
      "id": "bfd5f112-10b3-48b0-bf5c-8641c1202619",
      "name": "Combine PDF Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        768
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst text = input.text || '';\nconst fileName = input.fileName || 'unknown';\nconst fileId   = input.fileId   || '';\nconst GEMINI_API_KEY = 'AIzaSyANx9IwSwGWI9Ttp8DCLgADi7z6zFcamNg';\n\n// No text — skip silently\nif (!text || text.trim().length < 10) {\n  return [{ json: { _skip: true, _reason: 'No readable text', source_file: fileName, file_id: fileId, processed_at: new Date().toISOString() } }];\n}\n\nconst response = await this.helpers.httpRequest({\n  method: 'POST',\n  url: `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${GEMINI_API_KEY}`,\n  headers: { 'content-type': 'application/json' },\n  body: {\n    contents: [{ parts: [{ text: `Extract invoice data from the text below.\nReturn ONLY a JSON object with these exact keys: supplier, invoice_number, invoice_date, amount, currency\n- invoice_date must be in YYYY-MM-DD format\n- amount must be a number only (no currency symbols)\n- currency must be a 3-letter ISO code (EUR, USD, GBP etc)\n- If a field cannot be found, set it to null\nReturn ONLY the raw JSON object. No explanation. No markdown. No backticks.\nInvoice text:\n${text.substring(0, 1000)}` }] }],\n    generationConfig: { temperature: 0, maxOutputTokens: 512, responseMimeType: 'application/json' }\n  },\n  json: true\n});\n\nconst raw = (response.candidates?.[0]?.content?.parts?.[0]?.text || '').trim().replace(/```json|```/g, '').trim();\n\nif (!raw) {\n  return [{ json: { _skip: true, _reason: 'Empty Gemini response', source_file: fileName, file_id: fileId, processed_at: new Date().toISOString() } }];\n}\n\nlet data;\ntry { data = JSON.parse(raw); }\ncatch(e) { return [{ json: { _skip: true, _reason: 'Invalid JSON from Gemini', source_file: fileName, file_id: fileId, processed_at: new Date().toISOString() } }]; }\nconst found = ['supplier','invoice_number','invoice_date','amount','currency']\n  .filter(f => data[f] !== null && data[f] !== undefined && data[f] !== '');\n\n// Need at least 3 out of 5 fields to be considered a valid invoice\nif (found.length < 3) {\n  return [{ json: { _skip: true, _reason: `Not an invoice – only found ${found.length}/5 fields`, source_file: fileName, file_id: fileId, processed_at: new Date().toISOString() } }];\n}\n\nreturn [{ json: {\n  _skip: false,\n  supplier:       data.supplier       ? String(data.supplier).trim()               : null,\n  invoice_number: data.invoice_number ? String(data.invoice_number).trim()         : null,\n  invoice_date:   data.invoice_date   ? String(data.invoice_date).trim()           : null,\n  amount:         data.amount         ? Number(data.amount)                        : null,\n  currency:       data.currency       ? String(data.currency).toUpperCase().trim() : null,\n  source_file:    fileName,\n  file_id:        fileId,\n  processed_at:   new Date().toISOString()\n} }];"
      },
